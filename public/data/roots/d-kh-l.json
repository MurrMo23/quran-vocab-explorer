","form":8,"count":1,"gloss":"place of entry, refuge","word":null,"ex":{"s":9,"a":57,"p":7,"ar":["لَوْ","يَجِدُونَ","مَلْجَـًٔا","أَوْ","مَغَـٰرَٰتٍ","أَوْ","مُدَّخَلًا","لَّوَلَّوْا۟","إِلَيْهِ","وَهُمْ","يَجْمَحُونَ"],"en":"If they could find a refuge or some caves or any place to enter [and hide], they would turn to it while they run heedlessly"}}],"surahs":[[4,12],[5,10],[12,9],[7,7],[2,6],[3,6],[16,5],[27,5],[40,5],[17,4],[22,4],[24,4],[48,4],[33,3],[66,3],[9,2],[13,2],[15,2],[18,2],[21,2],[39,2],[47,2],[71,2],[89,2],[14,1],[19,1],[28,1],[29,1],[35,1],[36,1],[38,1],[42,1],[43,1],[45,1],[49,1],[50,1],[51,1],[58,1],[61,1],[64,1],[65,1],[68,1],[70,1],[76,1],[110,1]]}