{"slug":"sh-q-q","ar":"ش ق ق","total":28,"core":"splitting; hardship; opposition","forms":[{"ar":"شَآقُّ","kind":"verb","form":3,"count":7,"gloss":"to oppose","word":null,"ex":{"s":59,"a":4,"p":3,"ar":["ذَٰلِكَ","بِأَنَّهُمْ","شَآقُّوا۟","ٱللَّهَ","وَرَسُولَهُۥ ۖ","وَمَن","يُشَآقِّ","ٱللَّهَ","فَإِنَّ","ٱللَّهَ","شَدِيدُ","ٱلْعِقَابِ"],"en":"That is because they opposed Allah and His Messenger. And whoever opposes Allah - then indeed, Allah is severe in penalty"}},{"ar":"شِقَاق","kind":"verbal noun","form":3,"count":7,"gloss":"opposition, dissension","word":null,"ex":{"s":38,"a":2,"p":6,"ar":["بَلِ","ٱلَّذِينَ","كَفَرُوا۟","فِى","عِزَّةٍ","وَشِقَاقٍ"],"en":"But those who disbelieve are in pride and dissension"}},{"ar":"ٱنشَقَّ","kind":"verb","form":7,"count":5,"gloss":"to be split asunder","word":null,"ex":{"s":84,"a":1,"p":3,"ar":["إِذَا","ٱلسَّمَآءُ","ٱنشَقَّتْ"],"en":"When the sky has split [open]"}},{"ar":"يَشَّقَّقُ","kind":"verb","form":5,"count":3,"gloss":"to split open","word":null,"ex":{"s":25,"a":25,"p":2,"ar":["وَيَوْمَ","تَشَقَّقُ","ٱلسَّمَآءُ","بِٱلْغَمَـٰمِ","وَنُزِّلَ","ٱلْمَلَـٰٓئِكَةُ","تَنزِيلًا"],"en":"And [mention] the Day when the heaven will split open with [emerging] clouds, and the angels will be sent down in successive descent"}},{"ar":"شَقَقْ","kind":"verb","form":1,"count":2,"gloss":"to cleave; to make difficult","word":null,"ex":{"s":80,"a":26,"p":2,"ar":["ثُمَّ","شَقَقْنَا","ٱلْأَرْضَ","شَقًّا"],"en":"Then We broke open the earth, splitting [it with sprouts]"}},{"ar":"شَقّ","kind":"noun","form":null,"count":1,"gloss":"splitting","word":null,"ex":{"s":80,"a":26,"p":4,"ar":["ثُمَّ","شَقَقْنَا","ٱلْأَرْضَ","شَقًّا"],"en":"Then We broke open the earth, splitting [it with sprouts]"}},{"ar":"شِقّ","kind":"noun","form":null,"count":1,"gloss":"great hardship","word":null,"ex":{"s":16,"a":7,"p":9,"ar":["وَتَحْمِلُ","أَثْقَالَكُمْ","إِلَىٰ","بَلَدٍ","لَّمْ","تَكُونُوا۟","بَـٰلِغِيهِ","إِلَّا","بِشِقِّ","ٱلْأَنفُسِ ۚ","إِنَّ","رَبَّكُمْ","لَرَ