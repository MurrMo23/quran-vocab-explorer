{"slug":"sh-h-d","ar":"ش ه د","total":160,"core":"witnessing; testimony; presence","forms":[{"ar":"شَهِيد","kind":"noun","form":null,"count":56,"gloss":"The Witness","word":"ash-shahid","ex":{"s":100,"a":7,"p":4,"ar":["وَإِنَّهُۥ","عَلَىٰ","ذَٰلِكَ","لَشَهِيدٌ"],"en":"And indeed, he is to that a witness"}},{"ar":"شَهِدَ","kind":"verb","form":1,"count":44,"gloss":"to witness, testify","word":null,"ex":{"s":83,"a":21,"p":1,"ar":["يَشْهَدُهُ","ٱلْمُقَرَّبُونَ"],"en":"Which is witnessed by those brought near [to Allah]"}},{"ar":"شَهَٰدَة","kind":"noun","form":null,"count":23,"gloss":"Testimony, witness; the seen world","word":"shahadah","ex":{"s":13,"a":9,"p":3,"ar":["عَـٰلِمُ","ٱلْغَيْبِ","وَٱلشَّهَـٰدَةِ","ٱلْكَبِيرُ","ٱلْمُتَعَالِ"],"en":"[He is] Knower of the unseen and the witnessed, the Grand, the Exalted"}},{"ar":"شَاهِد","kind":"active participle","form":null,"count":21,"gloss":"witness; present","word":null,"ex":{"s":74,"a":13,"p":2,"ar":["وَبَنِينَ","شُهُودًا"],"en":"And children present [with him]"}},{"ar":"أَشْهَدَ","kind":"verb","form":4,"count":7,"gloss":"to call to witness","word":null,"ex":{"s":18,"a":51,"p":2,"ar":["مَّآ","أَشْهَدتُّهُمْ","خَلْقَ","ٱلسَّمَـٰوَٰتِ","وَٱلْأَرْضِ","وَلَا","خَلْقَ","أَنفُسِهِمْ","وَمَا","كُنتُ","مُتَّخِذَ","ٱلْمُضِلِّينَ","عَضُدًا"],"en":"I did not make them witness to the creation of the heavens and the earth or to the creation of themselves, and I would not have taken the misguiders as assistants"}},{"ar":"شَهَٰدَٰت","kind":"noun","form":null,"count":3,"gloss":"testimonies","word":null,"ex":{"s":70,"a":33,"p":3,"ar":["وَٱلَّذِينَ","هُم","بِشَهَـٰدَٰتِهِمْ","قَآئِمُونَ"],"en":"And those who are in their testimonies upright"}},{"ar":"مَشْهُود","kind":"passive participle","form":null,"count":3,"gloss":"witnessed","word":null,"ex":{"s":85,"a":3,"p":2,"ar":["وَشَاهِدٍ","وَمَشْهُودٍ"],"en":"And [by] the witness and what is witnessed"}},{"ar":"ٱسْتَشْهِدُ","kind":"verb","form":10,"count":2,"gloss":"to call witnesses","word":nu