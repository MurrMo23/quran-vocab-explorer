{"slug":"m-h-d","ar":"م ه د","total":16,"core":"spreading; bed; cradle","forms":[{"ar":"مِهَٰد","kind":"noun","form":null,"count":7,"gloss":"resting place, bed","word":null,"ex":{"s":38,"a":56,"p":4,"ar":["جَهَنَّمَ","يَصْلَوْنَهَا","فَبِئْسَ","ٱلْمِهَادُ"],"en":"Hell, which they will [enter to] burn, and wretched is the resting place"}},{"ar":"مَهْد","kind":"noun","form":null,"count":5,"gloss":"cradle","word":null,"ex":{"s":3,"a":46,"p":4,"ar":["وَيُكَلِّمُ","ٱلنَّاسَ","فِى","ٱلْمَهْدِ","وَكَهْلًا","وَمِنَ","ٱلصَّـٰلِحِينَ"],"en":"He will speak to the people in the cradle and in maturity and will be of the righteous"}},{"ar":"مَٰهِدُون","kind":"active participle","form":null,"count":1,"gloss":"spreaders","word":null,"ex":{"s":51,"a":48,"p":4,"ar":["وَٱلْأَرْضَ","فَرَشْنَـٰهَا","فَنِعْمَ","ٱلْمَـٰهِدُونَ"],"en":"And the earth We have spread out, and excellent is the preparer"}},{"ar":"مَهَّد","kind":"verb","form":2,"count":1,"gloss":"to spread, smooth","word":null,"ex":{"s":74,"a":14,"p":1,"ar":["وَمَهَّدتُّ","لَهُۥ","تَمْهِيدًا"],"en":"And spread [everything] before him, easing [his life]"}},{"ar":"تَمْهِيد","kind":"verbal noun","form":2,"count":1,"gloss":"smoothing, spreading","word":null,"ex":{"s":74,"a":14,"p":3,"ar":["وَمَهَّدتُّ","لَهُۥ","تَمْهِيدًا"],"en":"And spread [everything] before him, easing [his life]"}},{"ar":"يَمْهَدُ","kind":"verb","form":1,"count":1,"gloss":"to prepare","word":null,"ex":{"s":30,"a":44,"p":9,"ar":["مَن","كَفَرَ","فَعَلَيْهِ","كُفْرُهُۥ ۖ","وَمَنْ","عَمِلَ","صَـٰلِحًا","فَلِأَنفُسِهِمْ","يَمْهَدُونَ"],"en":"Whoever disbelieves - upon him is [the consequence of] his disbelief. And whoever does righteousness - they are for themselves preparing"}}],"surahs":[[3,3],[74,2],[2,1],[5,1],[7,1],[13,1],[19,1],[20,1],[30,1],[38,1],[43,1],[51,1],[78,1]]}